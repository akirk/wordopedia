{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Wordopedia",
		"description": "A personal encyclopedia for searching, browsing, and saving articles.",
		"author": "Alex Kirk"
	},
	"landingPage": "/wp-admin/index.php?desktop_mode_portal=1",
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/WordPress/openstation/releases/latest/download/openstation.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/akirk/wordopedia",
				"ref": "dist/main",
				"refType": "branch"
			},
			"options": {
				"targetFolderName": "wordopedia"
			}
		}
	]
}
